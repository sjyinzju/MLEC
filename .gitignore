# Generated audit inventory exceeds GitHub's per-file size limit
/audit/file_manifest.csv

# Local archives of directories already stored in this repository
/data_raw.zip
/deliverables.zip

# Local optional dependencies and reproducible binary model artifacts
.local_deps/
/artifacts/models/
/audit/framework/*.log
/data/raw/macro/official_sources/pages/
/data/raw/macro/original_submissions/packages/
# Reference implementation downloads are local inspection aids, not dependencies.
/data/raw/macro/source_references/*.txt
/data/raw/macro/source_references/*.js
/audit/framework/matplotlib_cache/

# Original responses and request ledgers are excluded and removed after absorption.
/data/raw/macro/official_sources/v3/objects/
/audit/data_foundation_v3/*.log

# Large local standardized data; raw and reproduction directories are not delivered.
/audit/final_data_foundation/temp/
/audit/final_data_foundation/reproducibility/**/before/
/data/raw/market/v4/
/data/raw/market/provider_supplements/v4/objects/
/data/standardized/market/v4/
/data/raw/public_sources/v4/objects/

# Obsolete full-population audit is not delivered.
/audit/final_data_foundation/market_coverage/adjusted_return_population.parquet

# Lightweight delivery policy: never recommit original responses or run artifacts.
/data/raw/
/audit/final_data_foundation/
/audit/data_foundation_v3/
/audit/framework/
/data/archive/data-foundation-v3/
*.log

# Rebuildable, partitioned stock projections; never duplicate the external lake.
/data/market_state/cache/

# Explicit experiment runs contain predictions, weights and resumable journals.
/results/

# Generated portable handover archives and staging outputs.
/deliverables/

# Isolated SVM launcher environment.
.venv-rbf-svm/

.venv-random-forest/
