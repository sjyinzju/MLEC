      "predicted_state_prob_1",
      "predicted_state_prob_2"
    ],
    "class_ids": [
      0,
      1,
      2
    ],
    "continuous": [
      {
        "field": "return",
        "unit": "ratio",
        "definition": "P[t+H]/P[t]-1; H=20",
        "dimension": "trend",
        "bounds": [
          -1,
          null
        ]
      },
      {
        "field": "volatility",
        "unit": "annualized ratio",
        "definition": "sqrt(252/H * sum(log(P[d]/P[d-1])^2))",
        "dimension": "volatility",
        "bounds": [
          0,
          null
        ]
      },
      {
        "field": "drawdown",
        "unit": "nonnegative loss ratio",
        "definition": "max(1-P[b]/P[a]), 0<=a<=b<=H; H+1 prices",
        "dimension": "downside",
        "bounds": [
          0,
          1
        ]
      },
      {
        "field": "amihud",
        "unit": "1/CNY",
        "definition": "mean over days of cross-sectional median(abs(adjusted log stock return)/CNY amount)",
        "dimension": "liquidity",
        "bounds": [
          0,
          null
        ]
      },
      {
        "field": "turnover",
        "unit": "ratio",
        "definition": "mean over days of sum(volume shares)/sum(float shares), same valid stock subset",
        "dimension": "liquidity",
        "bounds": [
          0,
          null
        ]
      },
      {
        "field": "breadth",
        "unit": "ratio",
        "definition": "mean over days of fraction of negative valid adjusted stock returns",
        "dimension": "structure",
        "bounds": [
          0,
          1
        ]
      },
      {
        "field": "correlation",
        "unit": "Pearson correlation",
        "definition": "mean of stock-pair correlations on complete common-date H-day panel; membership required on every day",
        "dimension": "structure",
        "bounds": [
          -1,
          1
        ]
      }
    ],
    "probability_atol": 1e-08,
    "decision_rule": "argmax; ties choose first class in dictionary order",
    "regression_units": "original",
    "economic_bound_policy": "record_without_clipping"
  },
