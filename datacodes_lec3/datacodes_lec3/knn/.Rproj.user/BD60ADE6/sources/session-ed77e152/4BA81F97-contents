## SVM for Multiclass Classification with MNIST Data



#mnist is an R package to download the MNIST database, based on a gist by Brendan O'Connor.\
#The entire dataset is returned as a single data frame. 
#The first 60,000 instances are the training set, the remaining 10,000 the test set. 
#The pixel values (integers in the range 0-255) are in columns with name px1, px2, px3 etc. 
#The label representing the numerical value of the digit is in the Label column (which is stored as a factor).

install.packages("devtools")
devtools::install_github("jlmelville/mnist")
library(mnist)

#install the "mnist" package, which contains the mnist data set

library(mnist)
read_mnist(
  path = NULL,
  download = FALSE,
  destdir = tempdir(),
  url = "https://www2.harvardx.harvard.edu/courses/IDS_08_v2_03/",
  keep.files = TRUE
)
data(mnist)

train_x <- mnist$Xtrain
train_y <- mnist$Ytrain
test_x <- mnist$Xtest
test_y <- mnist$Ytest

set.seed(1)
index1 <- sample(nrow(train_x),1000)
train_x <- train_x[index1,] 
train_y <- train_y[index1] 

set.seed(10)
index2 <- sample(nrow(test_x),1000)
test_x <- test_x[index2,] 
test_y <- test_y[index2] 

dim(train_x)
str(train_x)
prop.table(table(train_y))

digit <- matrix(as.numeric(train_x[4,]), nrow = 28) #look at one digit
image(digit, col = grey.colors(255))

train_x8 <- train_x[train_y==8,]
par(mfrow=c(3,3))
par(mar=c(2,2,2,2))
for (i in 1:9){
  digit <- t(apply(matrix(as.numeric(train_x8[i,]),nrow=28),2,rev)) #look at one digit
  image(digit, col = grey.colors(255))
}
par(mfrow=c(1,1))

library(e1071)
train_data <- data.frame(y=as.factor(train_y),train_x)

fit <- svm(y~., data=train_data, kernel="linear", cost=10)
pred <- predict(fit,test_x)
(table <- table(Predicted=pred,Actual=test_y))
(accuracy <- sum(diag(table))/sum(table))

fit <- svm(y~., data=train_data, kernel="polynomial",degree=2, gamma=0.02, cost=10)
pred <- predict(fit,test_x)
table <- table(Predicted=pred,Actual=test_y)
(accuracy <- sum(diag(table))/sum(table))

fit <- svm(y~., data=train_data, kernel="polynomial",degree=3, gamma=0.02, cost=10)
pred <- predict(fit,test_x)
table <- table(Predicted=pred,Actual=test_y)
(accuracy <- sum(diag(table))/sum(table))

fit <- svm(y~., data=train_data, kernel="radial",gamma=0.02, cost=10)
pred <- predict(fit,test_x)
table <- table(Predicted=pred,Actual=test_y)
(accuracy <- sum(diag(table))/sum(table))

